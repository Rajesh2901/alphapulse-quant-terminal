# ==============================================================================
# AlphaPulse Quantitative Terminal - Environment Configuration Template
# Duplicate this file to .env or inject as environment variables in production.
# ==============================================================================

# Google Gemini API Key for autonomous quantitative research memos
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Environment (development | staging | production)
APP_ENV=production

# Server Configuration
PORT=8501
HOST=0.0.0.0

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Market Data Ingestion Cache TTL (seconds)
CACHE_TTL_SECONDS=10
